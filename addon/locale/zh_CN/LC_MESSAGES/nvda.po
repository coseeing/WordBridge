#. Translators: Reported when a guest's text is longer than the Coseeing service accepts from
#. guests; {limit} is the number of characters allowed.
#: addon/globalPlugins/WordBridge/__init__.py:236
#, python-brace-format
msgid ""
"Guests can correct up to {limit} characters at a time. Sign in to Coseeing "
"to correct longer text."
msgstr "访客每次最多可校对 {limit} 字，登录 Coseeing 即可校对更长的文本。"

#. Translators: Reported when the text is longer than the Coseeing service accepts; {limit} is the
#. number of characters allowed.
#: addon/globalPlugins/WordBridge/__init__.py:242
#, python-brace-format
msgid ""
"The text is too long. Up to {limit} characters can be corrected at a time."
msgstr "文本过长，每次最多可校对 {limit} 字。"

#. Translators: Reported when the Coseeing service's guest quota has been used up.
#: addon/globalPlugins/WordBridge/__init__.py:247
msgid ""
"Today's guest quota has been used up. Please try again later or sign in to "
"Coseeing."
msgstr "今日访客额度已用完，请稍后重试或登录 Coseeing。"

#. Translators: Reported when the quota of the user's Coseeing account has been used up.
#: addon/globalPlugins/WordBridge/__init__.py:251
msgid "Your Coseeing account's quota has been used up."
msgstr "你的 Coseeing 账户额度已用完。"

#. Translators: Reported when the Coseeing service does not offer the model selected in the settings.
#: addon/globalPlugins/WordBridge/__init__.py:255
msgid ""
"The selected model is currently unavailable. Please choose another model in "
"the settings."
msgstr "所选模型当前不可用，请在设置中改选其他模型。"

#. Translators: Reported when the AI service behind Coseeing is too busy to answer.
#: addon/globalPlugins/WordBridge/__init__.py:259
msgid "The AI service is currently overloaded. Please try again later."
msgstr "AI 服务当前过载，请稍后重试。"

#. Translators: Reported when the AI service behind Coseeing has reached its usage limit.
#: addon/globalPlugins/WordBridge/__init__.py:263
msgid ""
"Coseeing's AI service has reached its usage limit for now. Please try again "
"later or choose another model."
msgstr "Coseeing 的 AI 服务暂时达到用量上限，请稍后重试或改选其他模型。"

#. Translators: Reported when the Coseeing service could not reach its AI service.
#: addon/globalPlugins/WordBridge/__init__.py:267
msgid "The AI service could not be reached. Please try again later."
msgstr "暂时无法连接到 AI 服务，请稍后重试。"

#. Translators: Reported when the AI service behind Coseeing rejects Coseeing's configuration.
#: addon/globalPlugins/WordBridge/__init__.py:271
msgid ""
"Coseeing's AI service is misconfigured. Please choose another model or try "
"again later."
msgstr "Coseeing 的 AI 服务配置有问题，请改选其他模型或稍后重试。"

#. Translators: Reported when the AI service behind Coseeing answered with an error.
#: addon/globalPlugins/WordBridge/__init__.py:275
msgid "The AI service returned an error. Please try again later."
msgstr "AI 服务发生错误，请稍后重试。"

#. Translators: Reported when the Coseeing service itself failed.
#: addon/globalPlugins/WordBridge/__init__.py:278
msgid "The Coseeing service encountered a problem. Please try again later."
msgstr "Coseeing 服务出现问题，请稍后重试。"

#. Translators: Reported when the Coseeing sign-in service cannot be reached.
#: addon/globalPlugins/WordBridge/__init__.py:281
msgid ""
"The Coseeing sign-in service is currently unavailable. Please try again "
"later."
msgstr "Coseeing 登录服务当前不可用，请稍后重试。"

#. Translators: Reported when the Coseeing service cannot confirm the user's account, for example
#. because its email address is not verified.
#: addon/globalPlugins/WordBridge/__init__.py:286
msgid ""
"Your Coseeing account could not be verified. Please make sure its email "
"address is verified, then sign in again."
msgstr "无法确认你的 Coseeing 账户，请确认电子邮箱已验证后重新登录。"

#. Translators: Reported when the user's Coseeing account has been disabled.
#: addon/globalPlugins/WordBridge/__init__.py:290
msgid "Your Coseeing account has been disabled. Please contact Coseeing."
msgstr "你的 Coseeing 账户已被停用，请联系 Coseeing。"

#. Translators: Reported when the user's sign-in conflicts with another Coseeing account.
#: addon/globalPlugins/WordBridge/__init__.py:293
msgid ""
"There is a conflict with your Coseeing account. Please contact Coseeing."
msgstr "你的 Coseeing 账户发生冲突，请联系 Coseeing。"

#. Translators: Reported when the correction settings file that comes with WordBridge is
#. damaged, so WordBridge uses its built-in defaults.
#: addon/globalPlugins/WordBridge/__init__.py:370
msgid ""
"The bundled correction settings file is damaged; WordBridge is using its "
"built-in defaults."
msgstr "随附的校正设置文件已损坏；WordBridge 正在使用内置默认设置。"

#. Translators: Message of a Yes/No dialog shown when the user starts a correction with a
#. model that uses their own API key, but the model list has not been downloaded. Yes
#. switches the setting to the Coseeing default and sends the text to Coseeing; No sends
#. nothing.
#: addon/globalPlugins/WordBridge/__init__.py:441
msgid ""
"The model list is not available yet, so the model you selected cannot be "
"used.\n"
"\n"
"Switch to the Coseeing default and correct this text with Coseeing? Your "
"WordBridge setting will be changed to the Coseeing default."
msgstr ""
"模型列表尚未获取，因此无法使用你选择的模型。\n"
"\n"
"要改用 Coseeing 默认，并使用 Coseeing 校正这段文本吗？你的 WordBridge 设置将"
"改为 Coseeing 默认。"

#. Translators: Title of the Yes/No dialog asking whether to switch to the Coseeing default;
#. the add-on name.
#. Translators: Title of the WordBridge category in NVDA's settings dialog; the add-on name.
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: addon/globalPlugins/WordBridge/__init__.py:447
#: addon/globalPlugins/WordBridge/dialogs.py:227 buildVars.py:20
msgid "WordBridge"
msgstr "WordBridge"

#. Translators: Spoken after the user answers No (or presses Escape) in the dialog asking whether to
#. switch to the Coseeing default because the model list is not available.
#: addon/globalPlugins/WordBridge/__init__.py:470
msgid "The text was not sent. Your model selection was not changed."
msgstr "文本未发送，模型选择未更改。"

#. Translators: Reported after a correction when its cost could not be calculated.
#: addon/globalPlugins/WordBridge/__init__.py:588
msgid "This task's cost is unavailable."
msgstr "无法获取此任务的费用。"

#. Translators: Reported after a correction; {cost} is what the request cost, in US dollars.
#: addon/globalPlugins/WordBridge/__init__.py:591
#, python-brace-format
msgid "This task costs {cost} USD."
msgstr "此任务费用为 {cost} 美元。"

#. Translators: Reported when the report of a correction (the page that shows the changes) could
#. not be created.
#: addon/globalPlugins/WordBridge/__init__.py:642
msgid "The correction report could not be generated."
msgstr "无法生成校对报告。"

#. Translators: Reported when the selected text is too long to correct; {len_text} is its
#. number of characters and {max_char_count} the maximum set in WordBridge settings.
#: addon/globalPlugins/WordBridge/__init__.py:658
#, python-brace-format
msgid ""
"The number of characters is {len_text}, which exceeds the maximum, "
"{max_char_count}."
msgstr "文本字符数为 {len_text}，超过最大值 {max_char_count}。"

#. Translators: Reported when a correction is started without any selected text.
#: addon/globalPlugins/WordBridge/__init__.py:667
msgid "No text is selected, unable to analyze."
msgstr "未选择文本，无法分析。"

#. Translators: Reported when the selected text has no Chinese characters, so there is nothing to
#. correct.
#: addon/globalPlugins/WordBridge/__init__.py:673
msgid ""
"The selected text does not contain Chinese characters, unable to analyze."
msgstr "所选文本不含汉字，无法分析。"

#. Translators: Reported once when the model list could not be loaded, so the correction goes to
#. the Coseeing service, which picks the model.
#: addon/globalPlugins/WordBridge/__init__.py:719
msgid ""
"The model list could not be loaded. Coseeing will choose a model for you."
msgstr "无法加载模型列表。Coseeing 将为你选择模型。"

#. Translators: Reported when the model chosen in WordBridge settings is no longer in
#. the model list.
#: addon/globalPlugins/WordBridge/__init__.py:728
msgid ""
"The selected model is no longer available. Please choose another one in "
"WordBridge settings."
msgstr "所选模型已不可用。请在 WordBridge 设置中选择其他模型。"

#. Translators: Reported when the service provider of the chosen model is no longer in
#. the model list.
#: addon/globalPlugins/WordBridge/__init__.py:738
msgid ""
"The selected provider is no longer available. Please choose another one in "
"WordBridge settings."
msgstr "所选服务提供商已不可用。请在 WordBridge 设置中选择其他服务提供商。"

#. Translators: Reported when a correction with the user's own API key fails; {e} is the
#. error message, which may come from the service provider untranslated.
#: addon/globalPlugins/WordBridge/__init__.py:769
#, python-brace-format
msgid ""
"Sorry, an error occurred during the program execution, the details are: {e}"
msgstr "抱歉，程序执行时发生错误，详情如下：{e}"

#. Translators: Reported when signing in to Coseeing failed before a correction could be sent.
#: addon/globalPlugins/WordBridge/__init__.py:787
msgid "Sorry, an error occurred while authenticating with Coseeing."
msgstr "抱歉，验证 Coseeing 时发生错误。"

#. Translators: Reported when a correction request to the Coseeing service took too long.
#: addon/globalPlugins/WordBridge/__init__.py:807
msgid "The Coseeing request timed out. Please try again later."
msgstr "Coseeing 请求超时，请稍后重试。"

#. Translators: Reported when a correction request to the Coseeing service failed.
#: addon/globalPlugins/WordBridge/__init__.py:810
#: addon/globalPlugins/WordBridge/__init__.py:842
msgid "The Coseeing request failed. Please try again later."
msgstr "Coseeing 请求失败，请稍后重试。"

#. Translators: Reported when the Coseeing service does not accept the user's sign-in (HTTP
#. 401).
#: addon/globalPlugins/WordBridge/__init__.py:827
#: addon/globalPlugins/WordBridge/__init__.py:1092
msgid ""
"Authentication error. Please sign in to Coseeing or check your account "
"permissions."
msgstr "身份验证错误。请登录 Coseeing 或检查账户权限。"

#. Translators: First sentence reported when the Coseeing service limits the user's
#. requests (HTTP 429); the next sentence follows it directly, so keep the trailing space.
#. Translators: First sentence reported when the AI service provider limits the user's requests
#. (HTTP 429); the next sentence follows it directly, so keep the trailing space.
#: addon/globalPlugins/WordBridge/__init__.py:834
#: addon/globalPlugins/WordBridge/lib/llm/provider.py:102
msgid "Rate limit reached for requests or you exceeded your current quota. "
msgstr "请求已达到速率限制，或已超出当前配额。"

#. Translators: Second sentence reported when the Coseeing service limits the user's
#. requests (HTTP 429).
#. Translators: Second sentence reported when the AI service provider limits the user's requests
#. (HTTP 429).
#: addon/globalPlugins/WordBridge/__init__.py:837
#: addon/globalPlugins/WordBridge/lib/llm/provider.py:105
msgid ""
"Please reduce the frequency of sending requests or check your account "
"balance."
msgstr "请降低请求发送频率，或检查账户余额。"

#. Translators: Reported when the Coseeing service's answer to a correction request could not
#. be read.
#: addon/globalPlugins/WordBridge/__init__.py:852
msgid "The Coseeing response was invalid. Please try again later."
msgstr "Coseeing 响应无效，请稍后重试。"

#. Translators: Reported when a correction found no errors in the selected text.
#: addon/globalPlugins/WordBridge/__init__.py:868
msgid "No errors in the selected text."
msgstr "所选文本中未检测到错误。"

#. Translators: Reported when a correction has finished and the corrected text is on the clipboard.
#: addon/globalPlugins/WordBridge/__init__.py:874
msgid "The corrected text has been copied to the clipboard."
msgstr "已将修正后的文本复制到剪贴板。"

#. Translators: Reported when a correction is started while another one is still running.
#: addon/globalPlugins/WordBridge/__init__.py:895
msgid ""
"Only one proofreading task can run at a time. Please wait until the current "
"task has finished before starting another."
msgstr "一次只能运行一项校对任务。请等待当前任务完成后再开始另一项任务。"

#. Translators: Description of the command that opens the WordBridge personal dictionary, shown in
#. Input gestures.
#: addon/globalPlugins/WordBridge/__init__.py:948
msgid "Open personal dictionary editor"
msgstr "打开个人词典编辑器"

#. Translators: Description of the command that corrects typos in the selected text, shown in Input
#. gestures.
#: addon/globalPlugins/WordBridge/__init__.py:958
msgid "Execute typo correction"
msgstr "执行错别字校正"

#. Translators: Reported when a correction is started while the NVDA settings dialog is
#. open.
#: addon/globalPlugins/WordBridge/__init__.py:967
msgid ""
"The function cannot be executed. Please finish the configuration and close "
"the setting window."
msgstr "无法执行该功能。请完成设置并关闭设置窗口。"

#. Translators: Description of the command that opens the WordBridge settings panel, shown in Input
#. gestures.
#: addon/globalPlugins/WordBridge/__init__.py:989
msgid "Open WordBridge settings"
msgstr "打开 WordBridge 设置"

#. Translators: Description of the command that shows the report of the latest correction, shown in
#. Input gestures.
#: addon/globalPlugins/WordBridge/__init__.py:1002
msgid "Show correction report"
msgstr "显示纠错报告"

#. Translators: Reported when the correction report is asked for before any correction has run.
#: addon/globalPlugins/WordBridge/__init__.py:1009
msgid "No report has been generated yet."
msgstr "尚未生成报告。"

#. Translators: Description of the command that sends feedback on the latest correction to Coseeing,
#. shown in Input gestures.
#: addon/globalPlugins/WordBridge/__init__.py:1019
msgid "Submit correction feedback"
msgstr "提交纠错反馈"

#. Translators: Reported when feedback is sent before any correction has run with the Coseeing
#. service.
#: addon/globalPlugins/WordBridge/__init__.py:1034
msgid ""
"You have not run a typos correction task with the Coseeing service provider "
"yet."
msgstr "尚未使用 Coseeing 服务提供商运行错别字校正任务。"

#. Translators: Reported when signing in to Coseeing failed before feedback could be sent.
#: addon/globalPlugins/WordBridge/__init__.py:1076
msgid "The Coseeing authentication failed. Please try again later."
msgstr "Coseeing 身份验证失败，请稍后重试。"

#. Translators: Reported when sending correction feedback to the Coseeing service failed.
#: addon/globalPlugins/WordBridge/__init__.py:1096
#: addon/globalPlugins/WordBridge/__init__.py:1111
msgid "Sorry, the Coseeing feedback request failed. Please try again later."
msgstr "抱歉，Coseeing 反馈请求失败，请稍后重试。"

#. Translators: Reported when sending correction feedback to the Coseeing service took too
#. long.
#: addon/globalPlugins/WordBridge/__init__.py:1104
msgid "The Coseeing feedback request timed out. Please try again later."
msgstr "Coseeing 反馈请求超时，请稍后重试。"

#. Translators: Reported when the Coseeing service's answer to correction feedback could not be
#. read.
#: addon/globalPlugins/WordBridge/__init__.py:1108
msgid "The Coseeing feedback response was invalid. Please try again later."
msgstr "Coseeing 反馈响应无效，请稍后重试。"

#. Translators: Shown when the model list URL uses plain http for a host other than this computer.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:35
msgid ""
"The model list URL must start with https://. http:// is allowed only for "
"localhost."
msgstr "模型列表网址必须以 https:// 开头。只有 localhost 可以使用 http://。"

#. Translators: Shown when the model list URL is not a complete web address.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:38
msgid ""
"Enter a complete web address, such as https://wordbridge.coseeing.org, or "
"leave the field empty."
msgstr ""
"请输入完整的网址，例如 https://wordbridge.coseeing.org，或将此字段留空。"

#. Translators: Part of the message after a failed test of the model list URL: a network error.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:54
msgid ""
"There was a network error. Check that you are connected to the internet and "
"try again."
msgstr "发生网络错误。请检查是否已连接互联网，然后重试。"

#. Translators: Part of the message after a failed test of the model list URL; {status} is the HTTP
#. status code the server answered with, for example 404.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:58
#, python-brace-format
msgid ""
"The server answered with HTTP status {status}. Check that the URL is correct."
msgstr "服务器返回 HTTP 状态码 {status}。请检查网址是否正确。"

#. Translators: Part of the message after a failed test of the model list URL: the address answered,
#. but not with a model list.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:64
msgid ""
"The server's answer is not a WordBridge model list. Check that the URL is "
"correct."
msgstr "服务器的响应不是 WordBridge 模型列表。请检查网址是否正确。"

#. Translators: Part of the message after a failed test of the model list URL: the list has no usable model.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:67
msgid "The model list offers no model WordBridge can use."
msgstr "该模型列表中没有 WordBridge 可以使用的模型。"

#. Translators: Part of the message after a failed test of the model list URL, for any other failure.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:69
msgid "Make sure you are connected to the internet and the URL is correct."
msgstr "请确认已连接互联网，且网址正确。"

#. Translators: Shown after a successful test of the model list URL; {count} is the number of models (1).
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:77
#, python-brace-format
msgid "The model list loaded. It offers {count} model."
msgstr "已加载模型列表，共有 {count} 个模型。"

#. Translators: Shown after a successful test of the model list URL; {count} is the number of models.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:80
#, python-brace-format
msgid "The model list loaded. It offers {count} models."
msgstr "已加载模型列表，共有 {count} 个模型。"

#. Translators: Shown after a failed test of the model list URL; {tip} says what went wrong and what to do.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:83
#, python-brace-format
msgid "The model list URL failed the test. {tip}"
msgstr "模型列表网址测试失败。{tip}"

#. Translators: Title of the dialog that changes the address the WordBridge model list is downloaded from.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:88
msgid "Set Model List URL"
msgstr "设置模型列表网址"

#. Translators: Label of the edit field for the web address the WordBridge model list is downloaded from.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:103
msgid "Model list URL:"
msgstr "模型列表网址："

#. Translators: Tooltip of the model list URL field in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:112
msgid ""
"The address WordBridge downloads the model list from. Leave it empty to use "
"only the Coseeing default."
msgstr "WordBridge 下载模型列表的网址。留空则只使用 Coseeing 默认。"

#. Translators: Button next to the model list URL field that checks whether the address offers a model list.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:117
msgid "&Test..."
msgstr "测试(&T)..."

#. Translators: Shown while WordBridge tests the model list URL.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:147
msgid "Validating the model list URL..."
msgstr "正在验证模型列表网址..."

#. Translators: Title of the message after a successful test of the model list URL.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:171
msgid "Success"
msgstr "成功"

#. Translators: Title of the message after a failed test of the model list URL.
#. Translators: Title of the message shown when the model list URL is not valid.
#. Translators: Title of an error message.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:174
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:203
#: addon/globalPlugins/WordBridge/dictionary/dialog.py:306
msgid "Error"
msgstr "错误"

#. Translators: Asked when the user saves a model list URL whose test failed.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:221
msgid "The model list URL failed the test. Save it anyway?"
msgstr "模型列表网址测试失败。仍要保存吗？"

#. Translators: Asked when the user saves a model list URL that was not tested.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:224
msgid ""
"The model list URL has not been tested. Save it without testing it first?"
msgstr "模型列表网址尚未测试。确定不先测试就保存吗？"

#. Translators: Title of the question asked before saving a model list URL that did not pass the test.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:229
msgid "Warning"
msgstr "警告"

#. Translators: An item of the Language choice in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:40
msgid "Traditional Chinese"
msgstr "繁体中文"

#. Translators: An item of the Language choice in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:42
msgid "Simplified Chinese"
msgstr "简体中文"

#. Translators: An item of the Correction Mode choice in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:44
msgid "Standard"
msgstr "标准"

#. Translators: An item of the Correction Mode choice in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:46
msgid "Lite"
msgstr "轻量"

#. Translators: Name of the kind of account that uses the user's own API key for a provider.
#: addon/globalPlugins/WordBridge/dialogs.py:48
msgid "Personal API Key"
msgstr "个人 API 密钥"

#. Translators: Name of the kind of account that signs in to Coseeing.
#: addon/globalPlugins/WordBridge/dialogs.py:50
msgid "Coseeing Account"
msgstr "Coseeing 账户"

#. Translators: The model label of the Coseeing default in the WordBridge settings panel's model choice.
#: addon/globalPlugins/WordBridge/dialogs.py:75
msgid "default"
msgstr "默认"

#. Translators: Status line in the WordBridge settings panel when the model list URL is empty, so the
#. model list that was included when the add-on was released is used.
#: addon/globalPlugins/WordBridge/dialogs.py:101
msgid ""
"The model list URL is empty, so WordBridge is using the model list that came "
"with the add-on."
msgstr "模型列表网址为空，因此 WordBridge 正在使用插件随附的模型列表。"

#. Translators: Status line in the WordBridge settings panel when the model list URL is empty.
#: addon/globalPlugins/WordBridge/dialogs.py:104
msgid "The model list URL is empty, so only the Coseeing default is available."
msgstr "模型列表网址为空，因此只能使用 Coseeing 默认。"

#. Translators: Status line in the WordBridge settings panel when the stored model list URL is not a valid
#. address, so the model list that was included when the add-on was released is used.
#: addon/globalPlugins/WordBridge/dialogs.py:110
msgid ""
"The model list URL is invalid, so WordBridge is using the model list that "
"came with the add-on."
msgstr "模型列表网址无效，因此 WordBridge 正在使用插件随附的模型列表。"

#. Translators: Status line in the WordBridge settings panel when the stored model list URL is not a valid
#. address, so no model list was downloaded.
