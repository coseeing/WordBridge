#. Translators: Reported when the AI service provider's answer has an unexpected shape;
#. {response} is that answer, shown as received.
#: addon/globalPlugins/WordBridge/lib/llm/executor.py:64
#, python-brace-format
msgid "Parsing error. Unexpected server response. Response: {response}"
msgstr "解析错误。服务器响应异常。响应内容：{response}"

#. Translators: Reported when the AI service provider rejects the user's API key (HTTP 401).
#: addon/globalPlugins/WordBridge/lib/llm/provider.py:60
msgid ""
"Authentication error. Please check if the service provider's key is correct."
msgstr "验证错误。请检查服务提供商的密钥是否正确。"

#. Translators: Reported when the AI service provider refuses requests from the user's location (HTTP 403).
#: addon/globalPlugins/WordBridge/lib/llm/provider.py:63
msgid "Country, region, or territory not supported."
msgstr "不支持你所在的国家、地区或领地。"

#. Translators: Reported when the AI service provider does not know the selected model (HTTP 404).
#: addon/globalPlugins/WordBridge/lib/llm/provider.py:66
msgid ""
"Service does not exist. Please check if the model does not exist or has "
"expired."
msgstr "服务不存在。请检查模型是否不存在或已过期。"

#. Translators: Reported when the AI service provider is too busy to answer (HTTP 503).
#: addon/globalPlugins/WordBridge/lib/llm/provider.py:78
msgid "The server is currently overloaded, please try again later."
msgstr "服务器当前负载过高，请稍后重试。"

#. Translators: Reported for any other error from the AI service provider; the HTTP status code
#. and the provider's own (untranslated) message follow it, as "401, message".
#: addon/globalPlugins/WordBridge/lib/llm/provider.py:83
msgid "An error occurred, status code = "
msgstr "发生错误，状态码 = "

#. Translators: Reported when the AI service provider cannot be reached; {request_error} is the
#. name of the network error, for example ConnectTimeout.
#: addon/globalPlugins/WordBridge/lib/llm/provider.py:108
#: addon/globalPlugins/WordBridge/lib/llm/provider.py:145
#, python-brace-format
msgid "HTTP request error ({request_error}). Please check the network setting."
msgstr "HTTP 请求错误（{request_error}）。请检查网络设置。"

#: addon/globalPlugins/WordBridge/dictionary/dialog.py:12
msgid ""
"Guideline:\n"
"Users can add words to improve the accuracy of added terms. It is "
"recommended to add specialized terms that may not be present in the model's "
"training data or terms that the model frequently make mistakes. The "
"pronunciation (pinyin or zhuyin) of an added word is optional, but providing "
"it can help improve correctness.\n"
"\n"
"For the format of pronunciation (pinyin or zhuyin), please see the following "
"rules and examples\n"
"1. Please insert a space between pronunciation of characters\n"
"2. Please use v instead of ü for pinyin\n"
"3. Please use number for pinyin's tone (no number for neutral tone)\n"
"\n"
"Example1:\n"
"Word: 爸爸\n"
"Pinyin: ba4 ba\n"
"Zhuyin: ㄅㄚˋ ㄅㄚ˙\n"
"\n"
"Example2:\n"
"Word: 旅遊\n"
"Pinyin: lv3 you2\n"
"Zhuyin: ㄌㄩˇ ㄧㄡˊ"
msgstr ""
"说明：\n"
"用户可以添加词汇来提高这些词汇的准确性。建议添加可能不在模型训练数据中的专有"
"名词或模型经常出错的词汇。词汇的发音（拼音或注音）可填可不填，但提供它可以帮"
"助提高正确性。\n"
"\n"
"关于发音（拼音或注音）的格式，请参见以下规则和范例：\n"
"1. 请在每个字的发音（拼音或注音）之间插入空格\n"
"2. 拼音中的ü请用v代替\n"
"3. 拼音的声调请使用数字（轻声不标数字）\n"
"\n"
"范例1：\n"
"词汇：爸爸\n"
"拼音：ba4 ba\n"
"注音：ㄅㄚˋ ㄅㄚ˙\n"
"\n"
"范例2：\n"
"词汇：旅游\n"
"拼音：lv3 you2\n"
"注音：ㄌㄩˇ ㄧㄡˊ"

