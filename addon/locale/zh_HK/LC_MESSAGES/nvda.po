#: addon/globalPlugins/WordBridge/__init__.py:265
msgid ""
"The bundled correction settings file is damaged; WordBridge is using its "
"built-in defaults."
msgstr "隨附的校正設定檔已損毀；WordBridge 正在使用內置預設值。"

#: addon/globalPlugins/WordBridge/__init__.py:326
msgid ""
"The model list is not available yet, so the model you selected cannot be "
"used.\n"
"\n"
"Switch to the Coseeing default and correct this text with Coseeing? Your "
"WordBridge setting will be changed to the Coseeing default."
msgstr ""
"模型清單尚未取得，因此無法使用你選擇的模型。\n"
"\n"
"要改用 Coseeing 預設，並使用 Coseeing 校正這段文字嗎？你的 WordBridge 設定會"
"改為 Coseeing 預設。"

#. Translators: Title of the Yes/No dialog asking whether to switch to the Coseeing default; the
#. add-on name.
#. Translators: Title of the WordBridge category in NVDA's settings dialog; the add-on name.
#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: addon/globalPlugins/WordBridge/__init__.py:332
#: addon/globalPlugins/WordBridge/dialogs.py:196 buildVars.py:21
msgid "WordBridge"
msgstr "WordBridge"

#. Translators: Spoken after the user answers No (or presses Escape) in the dialog asking whether to switch
#. to the Coseeing default because the model list is not available.
#: addon/globalPlugins/WordBridge/__init__.py:355
msgid "The text was not sent. Your model selection was not changed."
msgstr "未傳送文字，模型選擇維持不變。"

#: addon/globalPlugins/WordBridge/__init__.py:468
msgid "This task's cost is unavailable."
msgstr "無法取得此任務的費用。"

#: addon/globalPlugins/WordBridge/__init__.py:470
#: addon/globalPlugins/WordBridge/__init__.py:471
#, python-brace-format
msgid "This task costs {cost} USD."
msgstr "此任務費用為 {cost} 美元。"

#: addon/globalPlugins/WordBridge/__init__.py:518
msgid "The correction report could not be generated."
msgstr "無法產生錯別字校正報告。"

#: addon/globalPlugins/WordBridge/__init__.py:531
#: addon/globalPlugins/WordBridge/__init__.py:537
#, python-brace-format
msgid ""
"The number of characters is {len_text}, which exceeds the maximum, "
"{max_char_count}."
msgstr "文字字元數為 {len_text}，超過上限 {max_char_count}。"

#: addon/globalPlugins/WordBridge/__init__.py:544
#: addon/globalPlugins/WordBridge/__init__.py:545
msgid "No text is selected, unable to analyze."
msgstr "未選取任何文字，無法分析。"

#: addon/globalPlugins/WordBridge/__init__.py:548
#: addon/globalPlugins/WordBridge/__init__.py:549
msgid ""
"The selected text does not contain Chinese characters, unable to analyze."
msgstr "所選文字不含中文字元，無法分析。"

#. Notify before marking announced: _run_on_ui() silently drops the
#. message when self._shutdown is already set, and the old order
#. (flag first) could mark this session's one-shot announcement
#. "delivered" even when it never reached the user.
#: addon/globalPlugins/WordBridge/__init__.py:592
msgid ""
"The model list could not be loaded. Coseeing will choose a model for you."
msgstr "無法載入模型清單。Coseeing 會為你選擇模型。"

#: addon/globalPlugins/WordBridge/__init__.py:597
msgid ""
"The selected model is no longer available. Please choose another one in "
"WordBridge settings."
msgstr "所選模型已無法使用。請在 WordBridge 設定中選擇其他模型。"

#: addon/globalPlugins/WordBridge/__init__.py:601
msgid ""
"The selected provider is no longer available. Please choose another one in "
"WordBridge settings."
msgstr "所選服務供應商已無法使用。請在 WordBridge 設定中選擇其他服務供應商。"

#. The user has already been notified. Re-raising here only
#. leaves an unhandled exception in a worker thread, which
#. lands in the NVDA log with nothing to act on.
#: addon/globalPlugins/WordBridge/__init__.py:627
#: addon/globalPlugins/WordBridge/__init__.py:628
#, python-brace-format
msgid ""
"Sorry, an error occurred during the program execution, the details are: {e}"
msgstr "抱歉，程式執行時發生錯誤，詳情如下：{e}"

#: addon/globalPlugins/WordBridge/__init__.py:641
msgid "Sorry, an error occurred while authenticating with Coseeing."
msgstr "抱歉，驗證 Coseeing 時發生錯誤。"

#: addon/globalPlugins/WordBridge/__init__.py:656
msgid "The Coseeing request timed out. Please try again later."
msgstr "Coseeing 請求逾時，請稍後再試。"

#: addon/globalPlugins/WordBridge/__init__.py:658
#: addon/globalPlugins/WordBridge/__init__.py:674
msgid "The Coseeing request failed. Please try again later."
msgstr "Coseeing 請求失敗，請稍後再試。"

#: addon/globalPlugins/WordBridge/__init__.py:665
#: addon/globalPlugins/WordBridge/__init__.py:890
msgid ""
"Authentication error. Please sign in to Coseeing or check your account "
"permissions."
msgstr "驗證錯誤。請登入 Coseeing，或檢查帳戶權限。"

#: addon/globalPlugins/WordBridge/__init__.py:669
#: addon/globalPlugins/WordBridge/lib/llm/provider.py:66
msgid "Rate limit reached for requests or you exceeded your current quota. "
msgstr "請求已達到速率限制，或已超出目前配額。"

#: addon/globalPlugins/WordBridge/__init__.py:670
#: addon/globalPlugins/WordBridge/lib/llm/provider.py:67
msgid ""
"Please reduce the frequency of sending requests or check your account "
"balance."
msgstr "請降低發送請求的頻率，或檢查帳戶餘額。"

#: addon/globalPlugins/WordBridge/__init__.py:682
msgid "The Coseeing response was invalid. Please try again later."
msgstr "Coseeing 回應無效，請稍後再試。"

#: addon/globalPlugins/WordBridge/__init__.py:694
#: addon/globalPlugins/WordBridge/__init__.py:695
msgid "No errors in the selected text."
msgstr "所選文字未偵測到錯誤。"

#: addon/globalPlugins/WordBridge/__init__.py:699
#: addon/globalPlugins/WordBridge/__init__.py:700
msgid "The corrected text has been copied to the clipboard."
msgstr "已將校正後的文字複製到剪貼簿。"

#: addon/globalPlugins/WordBridge/__init__.py:717
msgid ""
"Only one proofreading task can run at a time. Please wait until the current "
"task has finished before starting another."
msgstr "一次只能執行一項校對任務。請等待目前任務完成後，再開始另一項任務。"

#: addon/globalPlugins/WordBridge/__init__.py:766
msgid "Open personal dictionary editor"
msgstr "開啟個人詞典編輯器"

#: addon/globalPlugins/WordBridge/__init__.py:774
msgid "Execute typo correction"
msgstr "執行錯別字校正"

#: addon/globalPlugins/WordBridge/__init__.py:780
#: addon/globalPlugins/WordBridge/__init__.py:783
msgid ""
"The function cannot be executed. Please finish the configuration and close "
"the setting window."
msgstr "無法執行此功能，請完成設定並關閉設定視窗。"

#: addon/globalPlugins/WordBridge/__init__.py:799
msgid "Open WordBridge settings"
msgstr "開啟 WordBridge 設定"

#: addon/globalPlugins/WordBridge/__init__.py:810
msgid "Show correction report"
msgstr "顯示校正報告"

#: addon/globalPlugins/WordBridge/__init__.py:816
#: addon/globalPlugins/WordBridge/__init__.py:817
msgid "No report has been generated yet."
msgstr "尚未產生報告。"

#: addon/globalPlugins/WordBridge/__init__.py:824
msgid "Submit correction feedback"
msgstr "提交校正意見回饋"

#: addon/globalPlugins/WordBridge/__init__.py:837
#: addon/globalPlugins/WordBridge/__init__.py:839
msgid ""
"You have not run a typos correction task with the Coseeing service provider "
"yet."
msgstr "您尚未使用 Coseeing 服務供應商執行錯別字校正任務。"

#: addon/globalPlugins/WordBridge/__init__.py:878
msgid "The Coseeing authentication failed. Please try again later."
msgstr "Coseeing 驗證失敗，請稍後再試。"

#: addon/globalPlugins/WordBridge/__init__.py:892
#: addon/globalPlugins/WordBridge/__init__.py:902
msgid "Sorry, the Coseeing feedback request failed. Please try again later."
msgstr "抱歉，Coseeing 意見回饋請求失敗，請稍後再試。"

#: addon/globalPlugins/WordBridge/__init__.py:898
msgid "The Coseeing feedback request timed out. Please try again later."
msgstr "Coseeing 意見回饋請求逾時，請稍後再試。"

#: addon/globalPlugins/WordBridge/__init__.py:900
msgid "The Coseeing feedback response was invalid. Please try again later."
msgstr "Coseeing 意見回饋回應無效，請稍後再試。"

#. Translators: Shown when the model list URL uses plain http for a host other than this computer.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:36
msgid ""
"The model list URL must start with https://. http:// is allowed only for "
"localhost."
msgstr "模型清單網址必須以 https:// 開頭。只有 localhost 可以使用 http://。"

#. Translators: Shown when the model list URL is not a complete web address.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:38
msgid ""
"Enter a complete web address, such as https://wordbridge.coseeing.org, or "
"leave the field empty."
msgstr ""
"請輸入完整的網址，例如 https://wordbridge.coseeing.org，或將此欄位留空。"

#. Translators: Part of the message after a failed test of the model list URL: a network error.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:53
msgid ""
"There was a network error. Check that you are connected to the internet and "
"try again."
msgstr "發生網絡錯誤。請確認已連接互聯網，然後再試一次。"

#. Translators: Part of the message after a failed test of the model list URL; {status} is the HTTP
#. status code the server answered with, for example 404.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:57
#, python-brace-format
msgid ""
"The server answered with HTTP status {status}. Check that the URL is correct."
msgstr "伺服器回應 HTTP 狀態碼 {status}。請確認網址是否正確。"

#. Translators: Part of the message after a failed test of the model list URL: the address answered,
#. but not with a model list.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:63
msgid ""
"The server's answer is not a WordBridge model list. Check that the URL is "
"correct."
msgstr "伺服器的回應不是 WordBridge 模型清單。請確認網址是否正確。"

#. Translators: Part of the message after a failed test of the model list URL: the list has no usable model.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:66
msgid "The model list offers no model WordBridge can use."
msgstr "此模型清單沒有 WordBridge 可以使用的模型。"

#. Translators: Part of the message after a failed test of the model list URL, for any other failure.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:68
msgid "Make sure you are connected to the internet and the URL is correct."
msgstr "請確認已連接互聯網，而且網址正確。"

#. Translators: Shown after a successful test of the model list URL; {count} is the number of models (1).
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:76
#, python-brace-format
msgid "The model list loaded. It offers {count} model."
msgstr "已載入模型清單，共有 {count} 個模型。"

#. Translators: Shown after a successful test of the model list URL; {count} is the number of models.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:79
#, python-brace-format
msgid "The model list loaded. It offers {count} models."
msgstr "已載入模型清單，共有 {count} 個模型。"

#. Translators: Shown after a failed test of the model list URL; {tip} says what went wrong and what to do.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:82
#, python-brace-format
msgid "The model list URL failed the test. {tip}"
msgstr "模型清單網址測試失敗。{tip}"

#. Translators: Title of the dialog that changes the address the WordBridge model list is downloaded from.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:87
msgid "Set Model List URL"
msgstr "設定模型清單網址"

#. Translators: Label of the edit field for the web address the WordBridge model list is downloaded from.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:102
msgid "Model list URL:"
msgstr "模型清單網址："

#. Translators: Tooltip of the model list URL field in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:109
msgid ""
"The address WordBridge downloads the model list from. Leave it empty to use "
"only the Coseeing default."
msgstr "WordBridge 下載模型清單的網址。留空則只使用 Coseeing 預設。"

#. Translators: Button next to the model list URL field that checks whether the address offers a model list.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:112
msgid "&Test..."
msgstr "測試(&T)..."

#. Translators: Shown while WordBridge tests the model list URL.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:142
msgid "Validating the model list URL..."
msgstr "正在驗證模型清單網址..."

#. Translators: Title of the message after a successful test of the model list URL.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:166
msgid "Success"
msgstr "成功"

#. Translators: Title of the message after a failed test of the model list URL.
#. Translators: Title of the message shown when the model list URL is not valid.
#. Translators: title of an error message
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:169
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:198
#: addon/globalPlugins/WordBridge/dictionary/dialog.py:286
msgid "Error"
msgstr "錯誤"

#. Translators: Asked when the user saves a model list URL whose test failed.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:216
msgid "The model list URL failed the test. Save it anyway?"
msgstr "模型清單網址測試失敗。仍要儲存嗎？"

#. Translators: Asked when the user saves a model list URL that was not tested.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:219
msgid ""
"The model list URL has not been tested. Save it without testing it first?"
msgstr "模型清單網址尚未測試。確定不先測試就儲存嗎？"

#. Translators: Title of the question asked before saving a model list URL that did not pass the test.
#: addon/globalPlugins/WordBridge/catalog_url_dialog.py:224
msgid "Warning"
msgstr "警告"

#. Translators: An item of the Language choice in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:42
msgid "Traditional Chinese"
msgstr "繁體中文"

#. Translators: An item of the Language choice in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:44
msgid "Simplified Chinese"
msgstr "簡體中文"

#. Translators: An item of the Correction Mode choice in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:46
msgid "Standard"
msgstr "標準"

#. Translators: An item of the Correction Mode choice in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:48
msgid "Lite"
msgstr "輕量"

#. Translators: Name of the kind of account that uses the user's own API key for a provider.
#: addon/globalPlugins/WordBridge/dialogs.py:50
msgid "Personal API Key"
msgstr "個人 API 金鑰"

#. Translators: Name of the kind of account that signs in to Coseeing.
#: addon/globalPlugins/WordBridge/dialogs.py:52
msgid "Coseeing Account"
msgstr "Coseeing 帳戶"

#. Translators: The model label of the Coseeing default in the WordBridge settings panel's model choice.
#: addon/globalPlugins/WordBridge/dialogs.py:77
msgid "default"
msgstr "預設"

#. Translators: Status line in the WordBridge settings panel when the model list URL is empty.
#: addon/globalPlugins/WordBridge/dialogs.py:99
msgid "The model list URL is empty, so only the Coseeing default is available."
msgstr "模型清單網址為空白，因此只能使用 Coseeing 預設。"

#. Translators: Status line in the WordBridge settings panel when the stored model list URL is not a valid
#. address, so no model list was downloaded.
#: addon/globalPlugins/WordBridge/dialogs.py:103
msgid "The model list URL is invalid, so no model list was loaded."
msgstr "模型清單網址無效，因此未載入模型清單。"

#. Translators: Status line in the WordBridge settings panel while the model list is still being downloaded.
#: addon/globalPlugins/WordBridge/dialogs.py:106
msgid ""
"The model list is still loading. Until it loads, only the Coseeing default "
"is available."
msgstr "模型清單仍在載入中。載入完成前，只能使用 Coseeing 預設。"

#: addon/globalPlugins/WordBridge/dialogs.py:111
msgid ""
"The model list could not be loaded, so only the Coseeing default is "
"available. See the NVDA log for details."
msgstr "無法載入模型清單，因此只能使用 Coseeing 預設。詳情請參閱 NVDA 記錄。"

#. Translators: Status line in the WordBridge settings panel when the model list could not be downloaded
#. and the copy saved earlier is used instead.
#: addon/globalPlugins/WordBridge/dialogs.py:116
msgid ""
"The model list could not be updated. WordBridge is using the list it saved "
"earlier."
msgstr "無法更新模型清單。WordBridge 正在使用之前儲存的清單。"

#. Translators: Spoken when the open WordBridge settings panel has just shown a newly downloaded list of
#. providers and models.
#: addon/globalPlugins/WordBridge/dialogs.py:147
msgid "Model list updated."
msgstr "模型清單已更新。"

#. Translators: Spoken when downloading the list of providers and models failed while the WordBridge settings
#. panel is open.
#: addon/globalPlugins/WordBridge/dialogs.py:150
msgid "Model list update failed."
msgstr "模型清單更新失敗。"

#. Translators: Line in the WordBridge settings panel when one entry of the model list could not be loaded.
#: addon/globalPlugins/WordBridge/dialogs.py:164
#, python-brace-format
msgid ""
"{count} catalog entry could not be loaded; see the NVDA log for details."
msgstr "無法載入 {count} 個目錄項目；詳情請參閱 NVDA 記錄。"

#. Translators: Line in the WordBridge settings panel when several entries of the model list could not be loaded;
#. {count} is their number.
#: addon/globalPlugins/WordBridge/dialogs.py:168
#, python-brace-format
msgid ""
"{count} catalog entries could not be loaded; see the NVDA log for details."
msgstr "無法載入 {count} 個目錄項目；詳情請參閱 NVDA 記錄。"

#. For selecting provider
#. Translators: Label of the choice of the service provider in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:250
msgid "Service Provider:"
msgstr "服務供應商："

#. Translators: Tooltip of the service provider choice in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:257
msgid "Choose the service provider for the WordBridge"
msgstr "選擇 WordBridge 使用的服務供應商"

#. For selecting LLM
#. Translators: Label of the choice of the large language model in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:263
msgid "Large Language Model:"
msgstr "大型語言模型："

#. Translators: Tooltip of the large language model choice in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:270
msgid "Choose the large language model for the Word Bridge"
msgstr "選擇 WordBridge 使用的大型語言模型"

#. For selecting language
#. Translators: Label of the choice of the correction language in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:286
msgid "Language:"
msgstr "語言："

#. Translators: Tooltip of the language choice in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:293
msgid "Choose the language for the Word Bridge"
msgstr "選擇 WordBridge 使用的語言"

#. For selecting typo correction mode
#. Translators: Label of the choice of the correction mode in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:298
msgid "Correction Mode:"
msgstr "校正模式："

#. Translators: Tooltip of the correction mode choice in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:305
msgid "Choose the typo correction mode for the Word Bridge"
msgstr "選擇 WordBridge 使用的錯別字校正模式"

#. For setting upper bound of correction character count
#. Translators: Label of the field for the largest number of characters WordBridge corrects at once.
#: addon/globalPlugins/WordBridge/dialogs.py:312
msgid "Max character count"
msgstr "最大字元數"

#. Translators: Check box in the WordBridge settings panel: show the typo report after each correction.
#: addon/globalPlugins/WordBridge/dialogs.py:326
msgid "Auto display typo report"
msgstr "自動顯示錯別字校正報告"

#. A setting and its button share a group, as NVDA's "NVDA Development"
#. group; the controls keep their full labels, as NVDA's do.
#. For setting custom dictionary
#. Translators: Label of the group in the WordBridge settings panel holding the personal dictionary settings.
#: addon/globalPlugins/WordBridge/dialogs.py:334
msgid "Personal dictionary"
msgstr "個人詞典"

#. Translators: Check box in the WordBridge settings panel: use the user's own dictionary in corrections.
#: addon/globalPlugins/WordBridge/dialogs.py:337
msgid "Apply personal dictionary"
msgstr "使用個人詞典"

#. Translators: Button in the WordBridge settings panel that opens the personal dictionary.
#: addon/globalPlugins/WordBridge/dialogs.py:345
msgid "Edit dictionary"
msgstr "編輯辭典"

#. For setting sound effects
#. Translators: Label of the group in the WordBridge settings panel holding the sound effect settings.
#: addon/globalPlugins/WordBridge/dialogs.py:352
msgid "Sound effects"
msgstr "音效"

#. Translators: Check box in the WordBridge settings panel: play sounds while a correction runs.
#: addon/globalPlugins/WordBridge/dialogs.py:355
msgid "Enable sound effect cues"
msgstr "啟用音效提示"

#. Translators: Button in the WordBridge settings panel that opens the web page crediting the sound effects.
#: addon/globalPlugins/WordBridge/dialogs.py:363
msgid "Sound effect credits"
msgstr "音效鳴謝"

#. Translators: Label of the group in the WordBridge settings panel showing the address the model list is
#. downloaded from.
#: addon/globalPlugins/WordBridge/dialogs.py:377
msgid "Model list URL"
msgstr "模型清單網址"

#. Translators: Button in the model list URL group of the WordBridge settings panel that opens the dialog
#. changing the address.
#: addon/globalPlugins/WordBridge/dialogs.py:384
msgid "Change..."
msgstr "更改..."

#. Translators: The end of an account box's caption in the WordBridge settings panel, after the provider name,
#. for example "OpenAI Authentication".
#: addon/globalPlugins/WordBridge/dialogs.py:610
msgid "Authentication"
msgstr "驗證"

#. Translators: Button in the Coseeing account box that signs out and removes the saved Coseeing sign-in.
#: addon/globalPlugins/WordBridge/dialogs.py:632
msgid "clean"
msgstr "清除"

#. Translators: Label of the field for a provider's API key in the WordBridge settings panel.
#: addon/globalPlugins/WordBridge/dialogs.py:639
msgid "API Key:"
msgstr "API 金鑰："

#. Translators: Shown in the model list URL group of the WordBridge settings panel when the URL is empty.
#: addon/globalPlugins/WordBridge/dialogs.py:698
