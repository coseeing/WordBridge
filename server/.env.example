# WordBridge server settings. Copy this file to server/.env and fill it in.
#
# Every variable in the first four sections is required. The server has no
# built-in values: when one is missing, empty or malformed, it refuses to
# start and lists every problem at once (app/settings.py). Variables already
# set in the environment take precedence over this file. The Docker image
# does not include .env files, so a container needs them passed in.

# --- Models -------------------------------------------------------------

# The model "default" requests run on, as model&Provider. It must be an
# active model in app/setting/catalog.json.
DEFAULT_CORRECTOR_CONFIG_ID=claude-sonnet-5-5&Anthropic
# Other model ids the server accepts, comma separated. Released add-ons send
# these two. Leave the value empty to serve only "default".
COSEEING_MODEL_IDS=deepseek-flash&DeepSeek,gpt-6-luna&OpenAI

# --- SSO ----------------------------------------------------------------

SSO_ISSUER=https://sso.coseeing.org
SSO_CLIENT_ID=wordbridge
SSO_USERINFO_URL=https://sso.coseeing.org/userinfo
# Seconds to wait for the UserInfo endpoint. Greater than 0.
SSO_USERINFO_TIMEOUT_SECONDS=6

# --- Database (MySQL) ---------------------------------------------------

DB_USER=wordbridge
DB_PASS=change-me
DB_HOST=wob-db
# 1 to 65535.
DB_PORT=3306
DATABASE=WordBridge

# --- Guest quotas -------------------------------------------------------

# Longest text, in characters, a guest may send. A whole number above 0.
GUEST_TEXT_LIMIT=128
# Spending allowed in each window: per guest IP address, and for all guests
# together. In the catalog's price unit; 0 or more.
GUEST_IP_QUOTA=0.06
GUEST_GLOBAL_QUOTA=0.3
# Length of the spending window, in hours. Greater than 0.
QUOTA_WINDOW_HOURS=24

# --- Provider API keys --------------------------------------------------

# Required for every provider a served model uses: the default model and
# each COSEEING_MODEL_IDS entry that is an active catalog model. The server
# refuses to start while one of those keys is missing or empty, and lists
# them all. Keys of providers no served model uses may stay empty. The keys
# are only checked for presence, not tried against the provider.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
